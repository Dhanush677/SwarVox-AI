ENVIRONMENT=local
APP_NAME=SwarVox AI
API_V1_PREFIX=/api/v1
SECRET_KEY=replace-with-a-long-random-value-before-production
WEBHOOK_SECRET=replace-with-a-provider-specific-secret-before-production
DATABASE_URL=postgresql+psycopg://swarvox:swarvox@localhost:5432/swarvox
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
# Future voice integrations remain disabled in the foundation stage.
TELEPHONY_PROVIDER=mock
DEFAULT_CALLER_ID=+910000000000
VITE_API_BASE_URL=http://127.0.0.1:8000
